#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${REPO_ROOT}"

dry_run=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) dry_run=true; shift ;;
    -h|--help)
      printf 'Usage: %s [--dry-run]\n' "$0"
      exit 0
      ;;
    *)
      printf 'Unknown option: %s\nUsage: %s [--dry-run]\n' "$1" "$0" >&2
      exit 2
      ;;
  esac
done

# Guard (plan E8): scripts must never flip the global Docker context. Use
# `docker --context pi-node ...` or a command-scoped DOCKER_CONTEXT instead.
# Always runs, independent of changed paths. This file is excluded from the scan.
context_pattern='docker[[:space:]]+context[[:space:]]+use'
context_offenders="$(
  grep -rInE "${context_pattern}" \
    --include='*.sh' --include='swingdev' --include='verify-changes' \
    dev-stack.sh bin infra scripts 2>/dev/null \
    | grep -v '^bin/verify-changes:' || true
)"
if [[ -n "${context_offenders}" ]]; then
  printf 'ERROR: scripts must not run "docker context use" (use `docker --context pi-node` or a scoped DOCKER_CONTEXT):\n%s\n' "${context_offenders}" >&2
  exit 1
fi

changed_paths="$(
  {
    git diff --name-only HEAD
    git ls-files --others --exclude-standard
  } | sort -u
)"

if [[ -z "${changed_paths}" ]]; then
  printf 'No changed files detected.\n'
  exit 0
fi

run_backend=false
run_dashboard=false
run_go=false
if grep -q '^backend/' <<<"${changed_paths}"; then run_backend=true; fi
if grep -q '^dashboard/' <<<"${changed_paths}"; then run_dashboard=true; fi
if grep -qE '^(go/|go\.work($|\.sum$)|\.golangci\.yml$|bin/(go-run|go-verify|check-go-architecture)$)' <<<"${changed_paths}"; then run_go=true; fi

failures=0

if [[ "${run_backend}" == "true" ]]; then
  if [[ "${dry_run}" == "true" ]]; then
    printf '[dry-run] (cd backend && ./gradlew test --no-daemon)\n'
  else
    printf '\nRunning backend tests for changed backend files...\n'
    if ! (cd backend && ./gradlew test --no-daemon); then
      failures=$((failures + 1))
    fi
  fi
fi

if [[ "${run_go}" == "true" ]]; then
  if [[ "${dry_run}" == "true" ]]; then
    printf '[dry-run] ./bin/go-verify\n'
  else
    printf '\nRunning Go unit, E2E, authorized development DB, race, vet, lint, vulnerability, and architecture checks...\n'
    if ! ./bin/go-verify; then
      failures=$((failures + 1))
    fi
  fi
fi

if [[ "${run_dashboard}" == "true" ]]; then
  if [[ "${dry_run}" == "true" ]]; then
    printf '[dry-run] (cd dashboard && yarn format:check && yarn typecheck && yarn test:run && yarn eslint . && yarn vite build)\n'
  else
    printf '\nRunning dashboard formatting, typecheck, tests, lint, and production build for changed dashboard files...\n'
    if ! (cd dashboard && yarn format:check && yarn typecheck && yarn test:run && yarn eslint . && yarn vite build); then
      failures=$((failures + 1))
    fi
  fi
fi

if [[ "${run_backend}" == "false" && "${run_dashboard}" == "false" && "${run_go}" == "false" ]]; then
  printf 'No backend, dashboard, or Go files changed; no application checks selected.\n'
fi

if [[ "${dry_run}" == "true" ]]; then
  printf '\nDry run complete; no checks were executed.\n'
  exit 0
fi

if [[ ${failures} -gt 0 ]]; then
  printf '\n%d check group(s) failed.\n' "${failures}" >&2
  exit 1
fi

printf '\nSelected checks passed.\n'
