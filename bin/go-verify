#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GO_BIN="$(command -v go)"
GOPATH="$("$GO_BIN" env GOPATH)"
LINTER="${GOLANGCI_LINT:-$GOPATH/bin/golangci-lint}"
VULN_CHECK="${GOVULNCHECK:-$GOPATH/bin/govulncheck}"
LOCAL_TEST_DATABASE="${SWINGTRADE_USE_LOCAL_TEST_DATABASE:-}"
unset SWINGTRADE_TEST_ALLOW_LOCAL_DATABASE
db_tests_enabled=true
if [[ "$LOCAL_TEST_DATABASE" == "1" ]]; then
  dev_db_url="postgresql://go_port_test@127.0.0.1:55433/go_port_test?sslmode=disable&application_name=go-port-test"
  use_local_test_database=true
  echo "Using the fixed loopback-only throwaway test database at 127.0.0.1:55433."
elif [[ -z "$LOCAL_TEST_DATABASE" ]]; then
  use_local_test_database=false
  if [[ -n "${SWINGTRADE_DEV_DATABASE_URL:-}" ]]; then
    python3 - <<'PY'
import os
import urllib.parse

try:
    parsed = urllib.parse.urlsplit(os.environ['SWINGTRADE_DEV_DATABASE_URL'])
    target = (parsed.hostname, parsed.port, parsed.path)
    options = urllib.parse.parse_qs(parsed.query, keep_blank_values=True)
except ValueError:
    raise SystemExit('Malformed development database URL.')
if (parsed.scheme not in {'postgres', 'postgresql'}
        or target != ('192.168.0.100', 5433, '/swingtrade')
        or options.get('sslmode') not in (['require'], ['verify-ca'], ['verify-full'])
        or set(options) - {'sslmode', 'application_name', 'sslrootcert'}
        or not parsed.username):
    raise SystemExit('Refusing a database target outside the captain-authorized development database.')
PY
    dev_db_url="$SWINGTRADE_DEV_DATABASE_URL"
    # Each run gets its own schema, so repeated and concurrent CI runs never
    # alter public or one another. The migration role has CREATE on the DB.
    command -v psql >/dev/null || { echo "psql is required for integration test provisioning." >&2; exit 1; }
    test_psql() {
      python3 - "$@" <<'PY'
import os, subprocess, sys, urllib.parse
u = urllib.parse.urlsplit(os.environ['SWINGTRADE_DEV_DATABASE_URL'])
env = os.environ.copy()
for key in ('PGSERVICE', 'PGSERVICEFILE'):
    env.pop(key, None)
sslmode = urllib.parse.parse_qs(u.query, keep_blank_values=True).get('sslmode', ['require'])[0]
sslrootcert = urllib.parse.parse_qs(u.query, keep_blank_values=True).get('sslrootcert', [None])[0]
env.update(PGHOST=u.hostname, PGPORT=str(u.port), PGDATABASE=u.path[1:],
           PGUSER=urllib.parse.unquote(u.username),
           PGPASSWORD=urllib.parse.unquote(u.password or ''), PGSSLMODE=sslmode)
if sslrootcert:
    env['PGSSLROOTCERT'] = sslrootcert
sys.exit(subprocess.call(['psql', '-X', '-q', '-v', 'ON_ERROR_STOP=1', *sys.argv[1:]], env=env))
PY
    }
    test_schema="go_port_ci_$(python3 -c 'import secrets; print(secrets.token_hex(8))')"
    if ! test_psql -c "CREATE SCHEMA $test_schema"; then
      echo "Could not create the integration test schema." >&2; exit 1
    fi
    cleanup_test_schema() {
      local status=$?
      trap - EXIT
      if ! test_psql -c "DROP SCHEMA IF EXISTS $test_schema CASCADE"; then
        echo "Could not remove integration test schema $test_schema." >&2
        exit 1
      fi
      exit "$status"
    }
    trap cleanup_test_schema EXIT
    if ! PGOPTIONS="-c search_path=$test_schema" test_psql -f "$REPO_ROOT/go/data/sqlc/schema.sql"; then
      echo "Could not provision integration test schema." >&2; exit 1
    fi
    dev_db_url="$(python3 - "$test_schema" <<'PY'
import os, sys, urllib.parse
u = urllib.parse.urlsplit(os.environ['SWINGTRADE_DEV_DATABASE_URL'])
query = urllib.parse.parse_qsl(u.query, keep_blank_values=True)
query = [(k, v) for k, v in query if k != 'search_path']
query.append(('search_path', sys.argv[1]))
print(urllib.parse.urlunsplit((u.scheme, u.netloc, u.path, urllib.parse.urlencode(query), u.fragment)))
PY
)"
  else
    echo "SWINGTRADE_DEV_DATABASE_URL is unavailable; skipping database integration tests."
    db_tests_enabled=false
  fi
else
  echo "SWINGTRADE_USE_LOCAL_TEST_DATABASE must be unset or exactly 1." >&2
  exit 1
fi

modules=(core data strategy llm gpuhub broker api)
failures=0
for module in "${modules[@]}"; do
  echo "== go/$module: module tidy, race tests, vet, lint, vulnerability scan =="
  if ! (
    cd "$REPO_ROOT/go/$module"
    if ! "$GO_BIN" mod tidy -diff; then
      echo "Go module tidy check failed in go/$module." >&2
      exit 1
    fi
    test_status=0
    if [[ "$db_tests_enabled" == "true" && ( "$module" == "data" || ( "$module" == "api" && "$use_local_test_database" == "false" ) ) ]]; then
      if [[ "$module" == "data" && "$use_local_test_database" == "true" ]]; then
        if test_output="$(SWINGTRADE_TEST_ALLOW_LOCAL_DATABASE=1 SWINGTRADE_TEST_DATABASE_URL="$dev_db_url" "$GO_BIN" test -tags integration -race -cover ./...)"; then :; else test_status=$?; fi
      elif test_output="$(SWINGTRADE_TEST_DATABASE_URL="$dev_db_url" "$GO_BIN" test -tags integration -race -cover ./...)"; then :; else test_status=$?; fi
    else
      if test_output="$("$GO_BIN" test -race -cover ./...)"; then :; else test_status=$?; fi
    fi
    printf '%s\n' "$test_output"
    if ! printf '%s\n' "$test_output" | python3 -c 'import re, sys
failed = False
for line in sys.stdin:
    match = re.search(r"^(?:ok|\?)\s+(\S+).*?coverage: ([0-9.]+)%", line)
    if not match:
        continue
    package, percentage = match.group(1), float(match.group(2))
    if percentage < 80:
        print(f"Coverage gate failed: {package} has {percentage:.1f}% statements; minimum is 80%.", file=sys.stderr)
        failed = True
if failed:
    sys.exit(1)'; then
      exit 1
    fi
    if ! "$GO_BIN" vet ./...; then
      echo "Go vet failed in go/$module." >&2
      exit 1
    fi
    if [[ ! -x "$LINTER" ]]; then
      echo "golangci-lint is required at $LINTER" >&2
      exit 1
    fi
    if ! "$LINTER" run --config "$REPO_ROOT/.golangci.yml" ./...; then
      echo "Go lint failed in go/$module." >&2
      exit 1
    fi
    if [[ ! -x "$VULN_CHECK" ]]; then
      echo "govulncheck is required at $VULN_CHECK" >&2
      exit 1
    fi
    if ! "$VULN_CHECK" ./...; then
      echo "Go vulnerability scan failed in go/$module." >&2
      exit 1
    fi
    if [[ "$test_status" -ne 0 ]]; then
      echo "Go tests failed in go/$module." >&2
      exit "$test_status"
    fi
  ); then
    failures=$((failures + 1))
  fi
done

"$REPO_ROOT/bin/check-go-architecture"
if [[ "$failures" -gt 0 ]]; then
  echo "$failures Go module check group(s) failed." >&2
  exit 1
fi
