# SwingTrade API Environment Variables
# Copy this file to .env and fill in your values
# IMPORTANT: Do not commit .env to git - it contains sensitive credentials

# Required: OpenAI API Key for LLM Sentiment Analysis
# This is used for the vLLM endpoint that provides sentiment analysis
# for news articles related to stocks in the swing-trade system
LANGCHAIN4J_OPEN_AI_API_KEY=your-api-key-here

# Optional: Custom Spring profiles
# Options: dev, native, prod
SPRING_PROFILES_ACTIVE=native

# Shared secret required by /api/admin/* in stage/live profiles.
API_KEY_AUTH_ENABLED=true
API_KEY=generate-a-long-random-secret

# Optional: Custom server port (default: 8080)
# Use 8081 for api-dev service (JAR build). The Go skeleton independently defaults to 8081.
SERVER_PORT=8080

# Go platform skeleton (optional overrides; local startup defaults to loopback)
HTTP_HOST=127.0.0.1
API_PUBLIC_RATE_LIMIT_PER_MINUTE=100
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
# Go DATABASE_URL: for development use pg-dev 192.168.0.100:5433/swingtrade
# and sslmode=require. Stage uses swingtrade_stage on the same endpoint.
# Use the swingtrade_app role; never commit its password.
# DATABASE_URL=postgresql://swingtrade_app:<password>@192.168.0.100:5433/swingtrade?sslmode=require
# Go integration tests use SWINGTRADE_DEV_DATABASE_URL with swingtrade_migration.
# SWINGTRADE_DEV_DATABASE_URL=postgresql://swingtrade_migration:<password>@192.168.0.100:5433/swingtrade?sslmode=require
# Java stage .env.stage must separately supply DB_USER=swingtrade_app, DB_PASSWORD,
# DB_MIGRATION_USER=swingtrade_migration and DB_MIGRATION_PASSWORD.

# Database Configuration (already in docker-compose, but can override)
# POSTGRES_USER=swingtrade_user
# POSTGRES_PASSWORD=swingtrade_password
# POSTGRES_DB=swingtrade_db

# =============================================================================
# Broker Integration
# =============================================================================
# For Fyers: set profile to "fyers" via SPRING_PROFILES_ACTIVE=dev,fyers
FYERS_CLIENT_ID=
FYERS_SECRET_KEY=
FYERS_ACCESS_TOKEN=
FYERS_REFRESH_TOKEN=

# For Upstox: set profile to "upstox" via SPRING_PROFILES_ACTIVE=dev,upstox
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_ACCESS_TOKEN=
UPSTOX_REDIRECT_URI=http://localhost:8080/api/auth/upstox/callback
