# Compiled class files
*.class

# Package files
*.jar
!libs/fyersjavasdk-1.9.0.jar
# The Gradle wrapper jar must be committed: without it ./gradlew does not run
# at all, which breaks dev-stack.sh and bin/e2e-gate on a fresh clone.
!backend/gradle/wrapper/gradle-wrapper.jar
*.war
*.ear
*.nar

# Build target directory
target/

# Gradle build output
backend/build/
backend/*/build/
backend/.gradle/
.gradle/

# IDE specific files
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.swo

# OS specific
.DS_Store
Thumbs.db

